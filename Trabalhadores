<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contato - Analisador</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #111318;
      color: #f4f6fb;
      padding: 20px;
    }

    .btn-open {
      background: #2563eb;
      color: #ffffff;
      border: none;
      padding: 14px 24px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.15s ease;
    }

    .btn-open:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 999;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-box {
      width: 100%;
      max-width: 440px;
      background: #1b1f27;
      border: 1px solid #2e3545;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .modal-header h2 {
      font-size: 18px;
    }

    .btn-close {
      background: transparent;
      border: none;
      color: #9aa4b8;
      font-size: 22px;
      cursor: pointer;
      line-height: 1;
    }

    .btn-close:hover {
      color: #ffffff;
    }

    .field {
      margin-bottom: 14px;
    }

    label {
      display: block;
      font-size: 14px;
      margin-bottom: 6px;
      color: #cbd5e1;
    }

    select,
    input,
    textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid #333b4d;
      background: #11141a;
      color: #f8fafc;
      font-size: 14px;
    }

    select:focus,
    input:focus,
    textarea:focus {
      outline: none;
      border-color: #3b82f6;
    }

    textarea {
      min-height: 95px;
      resize: vertical;
    }

    .custom-setor-wrap {
      display: none;
      margin-top: 8px;
    }

    .custom-setor-wrap.visible {
      display: block;
    }

    .actions {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 18px;
    }

    .btn-cancel {
      background: #2b3240;
      color: #e2e8f0;
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
    }

    .btn-send {
      background: #16a34a;
      color: #ffffff;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: bold;
    }

    .btn-send:hover {
      background: #15803d;
    }

    .feedback {
      margin-top: 12px;
      font-size: 13px;
      color: #86efac;
      min-height: 18px;
    }
  </style>
</head>
<body>
  <button type="button" class="btn-open" id="openModalBtn">
    Enviar mensagem para email do analisador
  </button>

  <div class="modal-backdrop" id="modalBackdrop" aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-header">
        <h2 id="modalTitle">Detalhes para o analisador</h2>
        <button type="button" class="btn-close" id="closeModalBtn" aria-label="Fechar">&times;</button>
      </div>

      <form id="analyzerForm">
        <div class="field">
          <label for="setorSelect">Em qual setor você quer ficar?</label>
          <select id="setorSelect" required>
            <option value="">Selecione um setor</option>
            <option value="Atendimento">Atendimento</option>
            <option value="Suporte Técnico">Suporte Técnico</option>
            <option value="Vendas">Vendas</option>
            <option value="Administração">Administração</option>
            <option value="Outro">Outro (digitar)</option>
          </select>

          <div class="custom-setor-wrap" id="customSetorWrap">
            <input
              type="text"
              id="customSetorInput"
              placeholder="Digite o setor desejado"
            />
          </div>
        </div>

        <div class="field">
          <label for="motivoInput">Por que você vai ficar lá?</label>
          <textarea
            id="motivoInput"
            placeholder="Explique o motivo de querer ficar nesse setor..."
            required
          ></textarea>
        </div>

        <div class="actions">
          <button type="button" class="btn-cancel" id="cancelBtn">Cancelar</button>
          <button type="submit" class="btn-send">Enviar</button>
        </div>

        <div class="feedback" id="feedbackMsg"></div>
      </form>
    </div>
  </div>

  <script>
    const ANALYZER_EMAIL = "victoralveslula@gmail.com";

    const openModalBtn = document.getElementById("openModalBtn");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const cancelBtn = document.getElementById("cancelBtn");
    const modalBackdrop = document.getElementById("modalBackdrop");
    const analyzerForm = document.getElementById("analyzerForm");
    const setorSelect = document.getElementById("setorSelect");
    const customSetorWrap = document.getElementById("customSetorWrap");
    const customSetorInput = document.getElementById("customSetorInput");
    const motivoInput = document.getElementById("motivoInput");
    const feedbackMsg = document.getElementById("feedbackMsg");

    function openModal() {
      feedbackMsg.textContent = "";
      modalBackdrop.classList.add("active");
      modalBackdrop.setAttribute("aria-hidden", "false");
    }

    function closeModal() {
      modalBackdrop.classList.remove("active");
      modalBackdrop.setAttribute("aria-hidden", "true");
    }

    openModalBtn.addEventListener("click", openModal);
    closeModalBtn.addEventListener("click", closeModal);
    cancelBtn.addEventListener("click", closeModal);

    modalBackdrop.addEventListener("click", (event) => {
      if (event.target === modalBackdrop) {
        closeModal();
      }
    });

    setorSelect.addEventListener("change", () => {
      const isOutro = setorSelect.value === "Outro";
      customSetorWrap.classList.toggle("visible", isOutro);
      customSetorInput.required = isOutro;
      if (!isOutro) {
        customSetorInput.value = "";
      }
    });

    analyzerForm.addEventListener("submit", (event) => {
      event.preventDefault();

      const setorEscolhido =
        setorSelect.value === "Outro"
          ? customSetorInput.value.trim()
          : setorSelect.value.trim();
      const motivo = motivoInput.value.trim();

      if (!setorEscolhido || !motivo) {
        feedbackMsg.style.color = "#fca5a5";
        feedbackMsg.textContent = "Preencha o setor e o motivo antes de enviar.";
        return;
      }

      const subject = encodeURIComponent(`Solicitação de Setor: ${setorEscolhido}`);
      const body = encodeURIComponent(
        `Setor desejado: ${setorEscolhido}\n\nPor que vai ficar lá:\n${motivo}`
      );

      feedbackMsg.style.color = "#86efac";
      feedbackMsg.textContent = "Abrindo seu aplicativo de e-mail para enviar...";

      window.location.href = `mailto:${ANALYZER_EMAIL}?subject=${subject}&body=${body}`;
    });
  </script>
</body>
</html>
